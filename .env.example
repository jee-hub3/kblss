# 이 파일을 .env로 복사한 뒤 실제 값을 채워 넣으세요.
# .env는 .gitignore에 등록돼 있으며 절대 커밋하지 않습니다.
#
# VITE_ 접두사가 붙은 값은 빌드 시 클라이언트 번들에 그대로 포함됩니다.
# 즉 브라우저에서 누구나 열람할 수 있으므로 비밀 값을 넣지 마세요.

# ── Notion (서버 전용) ────────────────────────────────
# 통합 토큰. 프록시(api/notion.js)와 지원서 저장(api/submitNotion.js)에서만 사용합니다.
NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 지원서가 저장되는 데이터베이스 ID
NOTION_RECRUIT_DB_ID=00000000000000000000000000000000

# ── Notion 데이터베이스 ID (클라이언트 노출) ──────────
# ID만으로는 토큰 없이 접근할 수 없어 노출되어도 무방합니다.
VITE_NOTION_PORTFOLIO_DB_ID=00000000000000000000000000000000
VITE_NOTION_NEWS_DB_ID=00000000000000000000000000000000
VITE_NOTION_METRICS_DB_ID=00000000000000000000000000000000
VITE_NOTION_HISTORY_DB_ID=00000000000000000000000000000000

# ── Google Analytics 4 (선택) ─────────────────────────
# 비워두면 GA4가 비활성화되고 콘솔 경고만 1회 출력됩니다.
# 로컬 개발 중에는 비워두는 것을 권장합니다.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
